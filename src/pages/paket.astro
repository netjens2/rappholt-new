---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Priser & Paket | Bröllopsvideograf Skåne | Rappholt Photo"
  description="Se våra paket för bröllopsfilm i Skåne. Cinematic kvalitet i 6K RAW med leverans inom 5 dagar."
>
  <Nav />
  
  <main class="packages-page">
    <section class="page-hero">
      <div class="container">
        <p class="section-label">Investering</p>
        <h1 class="page-title">Spara magin för framtiden</h1>
        <p class="page-description">
          Ingen lång väntetid. Ni får er professionella bröllopsfilm levererad inom 5 dagar – medan känslorna fortfarande är färska.
        </p>
      </div>
    </section>

    <section class="packages-section">
      <div class="container">
        <div class="packages-grid">
          
          <div class="package-card">
            <h3 class="package-name">Den Intima Berättelsen</h3>
            <p class="package-description">4-5 timmar – Perfekt för vigsel & mingel</p>
            <ul class="package-features">
              <li>Vigsel, porträtt & mingel</li>
              <li>Cinematic Highlight (4-6 min)</li>
              <li>Leverans inom 5 arbetsdagar</li>
              <li>Filmat i 6K RAW Cinema Quality</li>
              <li>Drönare (om vädret tillåter)</li>
            </ul>
            <a href="/kontakt" class="package-cta">Se om mitt datum är ledigt</a>
          </div>

          <div class="package-card featured">
            <span class="featured-badge">Populärast</span>
            <h3 class="package-name">Hela Historien</h3>
            <p class="package-description">10-12 timmar – Från förberedelser till fest</p>
            <ul class="package-features">
              <li>Dokumentation av hela dagen</li>
              <li>Cinematic Highlight (4-6 min)</li>
              <li>Alla tal levererade separat</li>
              <li>Leverans inom 5 arbetsdagar</li>
              <li>Filmat i 6K RAW Cinema Quality</li>
            </ul>
            <a href="/kontakt" class="package-cta">Boka ert datum</a>
          </div>

          <div class="package-card">
            <h3 class="package-name">Destination</h3>
            <p class="package-description">Bröllop utanför Skåne eller utomlands</p>
            <ul class="package-features">
              <li>Fullständig bevakning oavsett plats</li>
              <li>Cinematic Highlight (4-6 min)</li>
              <li>Leverans inom 5 arbetsdagar</li>
              <li>Filmat i 6K RAW Cinema Quality</li>
              <li>Resplanering & logistikstöd</li>
            </ul>
            <a href="/kontakt" class="package-cta">Få prisförslag</a>
          </div>

        </div>
      </div>
    </section>

    <section class="faq-section">
      <div class="container">
        <h2 class="faq-title">Vanliga frågor</h2>
        <div class="faq-list">
          <div class="faq-item">
            <h4 class="faq-question">Varför vänta 3 månader? (5 dagars leverans)</h4>
            <p class="faq-answer">De flesta levererar efter 8-12 veckor. Genom ett optimerat workflow levererar jag er film inom 5 arbetsdagar så att ni kan se den medan känslan är kvar.</p>
          </div>
          <div class="faq-item">
            <h4 class="faq-question">Vad innebär 6K RAW?</h4>
            <p class="faq-answer">Det är Hollywood-standard för bildkvalitet. Det ger fantastiska färger och en film som ser bra ut även på framtidens skärmar.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .packages-page { padding-top: 100px; background: var(--color-bg); }
  .page-hero { padding: 80px 0; text-align: center; }
  .section-label { color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.2em; font-size: 14px; margin-bottom: 16px; }
  .page-title { font-size: clamp(32px, 5vw, 48px); margin-bottom: 16px; color: var(--color-text); }
  .page-description { color: var(--color-text-muted); font-size: 18px; max-width: 600px; margin: 0 auto; }

  .packages-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin: 60px 0; }
  .package-card { background: var(--color-bg-elevated); padding: 40px; border: 1px solid var(--color-border); border-radius: 8px; position: relative; display: flex; flex-direction: column; }
  .package-card.featured { border-color: var(--color-accent); transform: scale(1.02); }
  
  .featured-badge { position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: var(--color-accent); color: var(--color-bg); padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: 700; }
  
  .package-name { font-size: 24px; margin-bottom: 12px; color: var(--color-text); font-family: var(--font-display); }
  .package-description { color: var(--color-text-muted); font-size: 14px; margin-bottom: 24px; }
  .package-features { list-style: none; flex-grow: 1; margin-bottom: 32px; padding: 0; }
  .package-features li { color: var(--color-text-muted); font-size: 14px; padding-left: 20px; position: relative; margin-bottom: 10px; }
  .package-features li::before { content: "✓"; position: absolute; left: 0; color: var(--color-accent); }
  
  .package-cta { text-align: center; padding: 16px; border: 1px solid var(--color-border); border-radius: 4px; color: var(--color-text); font-size: 12px; font-weight: 600; text-transform: uppercase; text-decoration: none; transition: 0.3s; }
  .package-card.featured .package-cta { background: var(--color-text); color: var(--color-bg); }
  .package-cta:hover { background: var(--color-accent); color: var(--color-bg); border-color: var(--color-accent); }

  .faq-section { padding: 80px 0; }
  .faq-title { text-align: center; margin-bottom: 40px; color: var(--color-text); font-size: 32px; font-family: var(--font-display); }
  .faq-list { max-width: 700px; margin: 0 auto; }
  .faq-item { border-bottom: 1px solid var(--color-border); padding: 24px 0; }
  .faq-question { color: var(--color-text); font-size: 18px; margin-bottom: 12px; }
  .faq-answer { color: var(--color-text-muted); line-height: 1.6; font-size: 16px; }

  @media (max-width: 1024px) { .packages-grid { grid-template-columns: 1fr; } }
</style>